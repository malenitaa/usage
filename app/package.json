{
  "name": "claude-usage-tray",
  "version": "1.2.7",
  "description": "macOS menu bar app showing official Claude Code rate limit usage (5h / 7d), minimal UI, native macOS system colors",
  "main": "src/main.js",
  "private": true,
  "author": "malenitaa",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "icon": "node build/make-icon.mjs",
    "build": "npm run icon && electron-builder --mac",
    "build:win": "npm run icon && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.malenitaa.claude-usage-tray",
    "productName": "Claude Usage",
    "toolsets": {
      "nsis": "1.2.1",
      "winCodeSign": "1.1.0"
    },
    "files": [
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": true
    },
    "afterSign": "build/notarize.js"
  }
}
