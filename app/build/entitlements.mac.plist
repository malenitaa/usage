<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 necesita JIT bajo hardened runtime. Sin firmar (build por defecto)
       esto no cambia nada; solo aplica cuando se firma con Developer ID para
       notarizar. No hay módulos nativos, así que no hacen falta
       allow-unsigned-executable-memory ni disable-library-validation. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
